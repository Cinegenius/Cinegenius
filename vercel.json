{
  "regions": [
    "fra1"
  ],
  "functions": {
    "app/api/native/v1/genie/**/route.ts": {
      "supportsCancellation": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/listing-freshness",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/profile-art",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/shots-cleanup",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/native-push",
      "schedule": "*/5 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
